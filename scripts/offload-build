#!/usr/bin/env python3
"""Offload named Mimir jobs. Uploads inputs to nixbuild.net and may incur charges."""
import argparse
import fnmatch
import json
import shlex
import subprocess
import sys

INSTALLABLE = '.#nixosConfigurations.mimir.config.system.build.toplevel'
REMOTE = 'ssh://eu.nixbuild.net aarch64-linux /etc/ssh/ssh_host_ed25519_key 1 1'


def nix(*args, capture=False):
    command = ['nix', *args]
    print('+ ' + shlex.join(command), flush=True)
    return subprocess.run(command, check=True, text=True, timeout=3600,
                          stdout=subprocess.PIPE if capture else None).stdout


def path(value):
    return value if value.startswith('/nix/store/') else '/nix/store/' + value


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('patterns', nargs='*', help='case-sensitive derivation-name globs')
    parser.add_argument('--dry-run', action='store_true', help='inspect only; no builds')
    args = parser.parse_args()
    patterns = args.patterns or ['nix-*-tests-run*', 'nix-functional-tests-*']
    raw = json.loads(nix('derivation', 'show', '--recursive', INSTALLABLE, capture=True))
    graph = {path(key): drv for key, drv in raw.get('derivations', raw).items()}
    deps = {}
    for key, drv in graph.items():
        deps[key] = {}
        for dep, spec in drv.get('inputDrvs', drv.get('inputs', {}).get('drvs', {})).items():
            if isinstance(spec, dict):
                if spec.get('dynamicOutputs'):
                    raise ValueError('Dynamic dependency outputs are unsupported: ' + key)
                spec = spec['outputs']
            deps[key][path(dep)] = ','.join(sorted(spec))
    selected = {key for key, drv in graph.items() if any(fnmatch.fnmatchcase(
        drv.get('name', drv.get('env', {}).get('name', '')), glob) for glob in patterns)}
    if not selected:
        raise ValueError('No derivation names match the supplied globs')
    ordered, visited, active = [], set(), set()

    def visit(key):
        if key in active:
            raise ValueError('Cycle in derivation graph: ' + key)
        if key in visited:
            return
        active.add(key)
        for dep in sorted(deps[key]):
            visit(dep)
        active.remove(key)
        visited.add(key)
        if key in selected:
            ordered.append(key)

    for key in sorted(selected):
        visit(key)
    for key in ordered:
        if graph[key]['system'] != 'aarch64-linux':
            raise ValueError('Only aarch64-linux jobs are supported: ' + key)
        print('Selected: ' + key, flush=True)
    if args.dry_run:
        print('Dry run: inspection only; no builds.')
        return
    for key in ordered:
        for dep, outputs in sorted(deps[key].items()):
            nix('build', '--store', 'daemon', '--no-link', '-L', dep + '^' + outputs)
        nix('build', '--store', 'daemon', '--no-link', '-L', '--max-jobs', '0',
            '--builders', REMOTE, key + '^*')
        nix('build', '--store', 'daemon', '--no-link', '--offline', '--max-jobs', '0',
            '--builders', '', key + '^*')
    print('Selected jobs complete; no enclosing build or activation performed.')


if __name__ == '__main__':
    try:
        main()
    except subprocess.TimeoutExpired:
        sys.exit('offload-build: timed out after 3600 seconds; remote work may survive. Inspect before retrying.')
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        sys.exit('offload-build: ' + str(error))
